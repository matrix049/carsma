# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/wall-decoration-ecommerce

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# Admin login — synced on every startup; any other admin is removed.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-unique-password

# Seed Secret Key (for API seeding)
SEED_SECRET_KEY=your-secret-seed-key-change-this

# Ntfy Push Notifications (Optional)
# Get the ntfy app: https://ntfy.sh/
# Create a unique topic name (e.g., carsma-orders-abc123)
NTFY_TOPIC=your-unique-topic-name
NTFY_SERVER=https://ntfy.sh

# Chat assistant (Gemini, free tier). Key from https://aistudio.google.com/apikey
# Without it the website chat still answers its built-in topics and sends requests to the team.
GEMINI_API_KEY=
# Optional: fixed fallback order, e.g. gemini-3.8-flash,gemini-3.5-flash
# (by default the server discovers the available free Flash models, newest first)
GEMINI_MODELS=

# WhatsApp order confirmation (Meta WhatsApp Cloud API). Off while TOKEN or PHONE_NUMBER_ID is empty.
# Meta app > WhatsApp > API Setup: token (a system user token for production) and the phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > Settings > Basic > App secret (webhooks are checked against it).
WHATSAPP_APP_SECRET=
# Any long random word; type the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Approved template (Utility) with {{1}} name, {{2}} items, {{3}} total, {{4}} address,
# and two quick-reply buttons: Confirm first, Cancel second.
WHATSAPP_TEMPLATE=order_confirmation
WHATSAPP_TEMPLATE_LANG=ar
